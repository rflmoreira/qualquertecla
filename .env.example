# Copie para `.env` na raiz (nunca versionar `.env` com valores reais).
# Produção: configure as mesmas variáveis no painel Netlify → Environment variables.

# ── Gemini TTS (Mary AI — áudio) ─────────────────────────────────────────────
# Preferencial: até 6 chaves independentes com rotação automática.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=

# Alternativa CSV (usada só se nenhuma GEMINI_API_KEY_1…6 estiver definida):
# GEMINI_API_KEYS=key1,key2,key3

# Legado: uma única chave (usada só se _1…6 e GEMINI_API_KEYS estiverem vazias):
# GEMINI_API_KEY=

# ── Groq (resumo por IA na publicação) ───────────────────────────────────────
GROQ_API_KEY=

# ── Outras (opcional) ────────────────────────────────────────────────────────
# SERPER_API_KEY=
